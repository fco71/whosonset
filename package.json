{
  "name": "whosonset",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "start": "webpack serve --mode development --config webpack.config.cjs",
    "build": "webpack --mode production --config webpack.config.cjs && node scripts/copy-static-seo-assets.cjs && node scripts/copy-template-to-functions.cjs",
    "build:prod": "REACT_APP_ENV=production webpack --mode production --config webpack.config.cjs && node scripts/copy-static-seo-assets.cjs && node scripts/copy-template-to-functions.cjs",
    "seed:countries": "node scripts/seedCountries.js",
    "seed:job-departments": "ts-node scripts/seedJobDepartments.ts",
    "seed:job-titles": "ts-node scripts/seedJobTitles.ts",
    "backfill:crew-search": "npm --prefix functions run build && node scripts/backfill-crew-search-index.cjs --apply",
    "deploy:dev": "firebase deploy --project my-film-jobs --only hosting:development",
    "deploy:prod": "firebase deploy --project my-film-jobs",
    "test": "vitest",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-whosonset \"vitest run --config vitest.rules.config.ts\"",
    "prepare": "husky"
  },
