# Compiled JavaScript files (generated by `tsc`; the deploy predeploy hook
# rebuilds lib/ every time, so build output must not be tracked).
lib/**/*.js
lib/**/*.js.map

# TypeScript v1 declaration files
typings/

# Node.js dependency directory
node_modules/
*.local

# Local backup dumps (run from scripts/backup-firestore*.sh)
crewProfiles-backup-*.json
*-backup-*.json