rules_version = '2';

// Regular security rules for client access
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserId(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function ownsSenderOrReceiver(data) {
      return signedIn() && (
        data.senderId == request.auth.uid ||
        data.receiverId == request.auth.uid
      );
    }

    function isConnectionParticipant(data) {
      return signedIn() && (
        data.userId == request.auth.uid ||
        data.connectedUserId == request.auth.uid
      );
    }

    function isConversationParticipant(data) {
      return signedIn() &&
        data.participants is list &&
        data.participants.hasAny([request.auth.uid]);
    }

    function isWorkspaceMemberData(data, uid) {
      return data.memberIds is list &&
        uid in data.memberIds;
    }

    function isScreenplayOwnerData(data) {
      return signedIn() &&
        data.uploadedBy == request.auth.uid;
    }

    function isScreenplayTeamMemberData(data) {
      return signedIn() &&
        data.teamMembers is list &&
        data.teamMembers.hasAny([request.auth.uid]);
    }

    function isScreenplayMemberData(data) {
      return isScreenplayOwnerData(data) ||
        isScreenplayTeamMemberData(data) ||
        canAccessWorkspace(data.workspaceId);
    }

    function canAccessWorkspace(workspaceId) {
      return signedIn() &&
        workspaceId is string &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        isWorkspaceMemberData(
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data,
          request.auth.uid
        );
    }

    function isEffectiveWorkspaceSupervisor(workspaceId, uid) {
      return signedIn() &&
        workspaceId is string &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        (
          (
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.supervisorIds is list &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.supervisorIds.hasAny([uid])
          ) ||
          (
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.selfElectedSupervisors is list &&
            get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.selfElectedSupervisors.hasAny([uid])
          )
        );
    }

    function isWorkspaceViewer(workspaceId, uid) {
      return signedIn() &&
        workspaceId is string &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.viewerIds is list &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.viewerIds.hasAny([uid]);
    }

    function isWorkspaceReadOnlyParticipant(workspaceId, uid) {
      return isEffectiveWorkspaceSupervisor(workspaceId, uid) ||
        isWorkspaceViewer(workspaceId, uid);
    }

    function isWorkspaceOwner(workspaceId, uid) {
      return signedIn() &&
        workspaceId is string &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == uid;
    }

    function isProjectParticipantData(data, uid) {
      return signedIn() && (
        data.createdBy == uid ||
        data.ownerId == uid ||
        data.owner_uid == uid ||
        (
          data.memberIds is list &&
          data.memberIds.hasAny([uid])
        ) ||
        (
          data.crewMemberIds is list &&
          data.crewMemberIds.hasAny([uid])
        ) ||
        (
          data.allowedViewers is list &&
          data.allowedViewers.hasAny([uid])
        ) ||
        (
          data.editorIds is list &&
          data.editorIds.hasAny([uid])
        )
      );
    }

    function isLowercaseProjectParticipant(projectId, uid) {
      return projectId is string &&
        exists(/databases/$(database)/documents/projects/$(projectId)) &&
        isProjectParticipantData(
          get(/databases/$(database)/documents/projects/$(projectId)).data,
          uid
        );
    }

    function isLegacyProjectParticipant(projectId, uid) {
      return projectId is string &&
        exists(/databases/$(database)/documents/Projects/$(projectId)) &&
        isProjectParticipantData(
          get(/databases/$(database)/documents/Projects/$(projectId)).data,
          uid
        );
    }

    function canAccessProject(projectId) {
      return signedIn() &&
        projectId is string &&
        (
          isLowercaseProjectParticipant(projectId, request.auth.uid) ||
          isLegacyProjectParticipant(projectId, request.auth.uid)
        );
    }

    function ownsProjectScopedRecord(data) {
      return signedIn() && (
        data.createdBy == request.auth.uid ||
        data.addedBy == request.auth.uid ||
        data.uploadedBy == request.auth.uid ||
        data.userId == request.auth.uid ||
        data.crewMemberId == request.auth.uid ||
        data.assignedTo == request.auth.uid
      );
    }

    function canAccessProjectScopedData(data) {
      return signedIn() &&
        (
          (
            data.projectId is string &&
            canAccessProject(data.projectId)
          ) ||
          ownsProjectScopedRecord(data)
        );
    }

    function canEditScreenplayData(data) {
      return isScreenplayMemberData(data) &&
        !isWorkspaceReadOnlyParticipant(data.workspaceId, request.auth.uid);
    }

    function canDeleteScreenplayData(data) {
      return canEditScreenplayData(data) &&
        (
          data.uploadedBy == request.auth.uid ||
          isWorkspaceOwner(data.workspaceId, request.auth.uid)
        );
    }

    function keepsScreenplayOwnership(newData, oldData) {
      return newData.uploadedBy == oldData.uploadedBy &&
        (
          (
            !newData.keys().hasAny(['workspaceId']) &&
            !oldData.keys().hasAny(['workspaceId'])
          ) ||
          (
            newData.keys().hasAny(['workspaceId']) &&
            oldData.keys().hasAny(['workspaceId']) &&
            newData.workspaceId == oldData.workspaceId
          )
        );
    }

    function isScreenplayContentUpdate(newData, oldData) {
      return canEditScreenplayData(oldData) &&
        newData.diff(oldData).affectedKeys().hasOnly([
          'fountainSource',
          'fountainUpdatedAt',
          'lastEditedBy',
          'lastModified'
        ]) &&
        (
          !newData.diff(oldData).affectedKeys().hasAny(['lastEditedBy']) ||
          newData.lastEditedBy == request.auth.uid
        );
    }

    function isScreenplayAccessUpdate(newData, oldData) {
      return (
          oldData.uploadedBy == request.auth.uid ||
          isWorkspaceOwner(oldData.workspaceId, request.auth.uid)
        ) &&
        newData.diff(oldData).affectedKeys().hasOnly([
          'teamMembers',
          'lastModified'
        ]);
    }

    function isScreenplayReviewStatusUpdate(newData, oldData, screenplayId) {
      return signedIn() &&
        newData.diff(oldData).affectedKeys().hasOnly([
          'reviewStatus',
          'reviewStatusUpdatedAt',
          'reviewStatusUpdatedBy',
          'reviewStatusNote',
          'lastModified'
        ]) &&
        newData.reviewStatus in ['draft', 'submitted', 'changes_requested', 'approved'] &&
        newData.reviewStatusUpdatedBy == request.auth.uid &&
        (
          (
            newData.reviewStatus in ['draft', 'submitted'] &&
            canEditScreenplayData(oldData)
          ) ||
          (
            newData.reviewStatus in ['changes_requested', 'approved'] &&
            isScreenplaySupervisor(screenplayId, request.auth.uid)
          ) ||
          (
            // Supervisor "Reopen feedback" undo: only from a feedback-finished
            // state back to submitted. Supervisors still cannot set draft.
            newData.reviewStatus == 'submitted' &&
            oldData.reviewStatus in ['changes_requested', 'approved'] &&
            isScreenplaySupervisor(screenplayId, request.auth.uid)
          )
        );
    }

    function canAccessScreenplay(screenplayId) {
      return signedIn() &&
        screenplayId is string &&
        exists(/databases/$(database)/documents/screenplays/$(screenplayId)) &&
        isScreenplayMemberData(get(/databases/$(database)/documents/screenplays/$(screenplayId)).data);
    }

    function canEditScreenplay(screenplayId) {
      return signedIn() &&
        screenplayId is string &&
        exists(/databases/$(database)/documents/screenplays/$(screenplayId)) &&
        canEditScreenplayData(
          get(/databases/$(database)/documents/screenplays/$(screenplayId)).data
        );
    }

    function isScreenplayManager(screenplayId, uid) {
      return signedIn() &&
        screenplayId is string &&
        exists(/databases/$(database)/documents/screenplays/$(screenplayId)) &&
        (
          get(/databases/$(database)/documents/screenplays/$(screenplayId)).data.uploadedBy == uid ||
          isWorkspaceOwner(
            get(/databases/$(database)/documents/screenplays/$(screenplayId)).data.workspaceId,
            uid
          )
        );
    }

    function isScreenplaySupervisor(screenplayId, uid) {
      return signedIn() &&
        screenplayId is string &&
        exists(/databases/$(database)/documents/screenplays/$(screenplayId)) &&
        isEffectiveWorkspaceSupervisor(
          get(/databases/$(database)/documents/screenplays/$(screenplayId)).data.workspaceId,
          uid
        );
    }

    function keepsAnnotationIdentity(newData, oldData) {
      return newData.screenplayId == oldData.screenplayId &&
        newData.userId == oldData.userId &&
        newData.get('supervisorAtAuthorTime', false) == oldData.get('supervisorAtAuthorTime', false);
    }

    function isValidScreenplayElementAnchor(data) {
      return data.screenplayId is string &&
        data.screenplayId.size() <= 200 &&
        data.projectId is string &&
        data.projectId.size() <= 200 &&
        data.userId is string &&
        data.userId.size() <= 200 &&
        data.userName is string &&
        data.userName.size() <= 200 &&
        data.get('userAvatar', '') is string &&
        data.get('userAvatar', '').size() <= 2000 &&
        data.timestamp is timestamp &&
        data.pageNumber is number &&
        data.pageNumber >= 0 &&
        data.pageNumber <= 10000 &&
        data.position is map &&
        data.position.keys().hasAll(['x', 'y', 'width', 'height']) &&
        data.position.keys().hasOnly(['x', 'y', 'width', 'height']) &&
        data.position.x is number &&
        data.position.y is number &&
        data.position.width is number &&
        data.position.height is number &&
        data.get('selection', '') is string &&
        data.get('selection', '').size() <= 500 &&
        data.resolved is bool &&
        data.supervisorAtAuthorTime is bool;
    }

    function hasValidMentionRecipients(data) {
      return data.get('mentionedUserIds', []) is list &&
        data.get('mentionedUserIds', []).size() <= 20;
    }

    function isValidAnnotationReply(reply) {
      return reply is map &&
        reply.keys().hasAll(['id', 'userId', 'userName', 'content', 'timestamp', 'supervisorAtAuthorTime']) &&
        reply.keys().hasOnly(['id', 'userId', 'userName', 'userAvatar', 'content', 'timestamp', 'supervisorAtAuthorTime']) &&
        reply.id is string &&
        reply.id.size() <= 100 &&
        reply.userId is string &&
        reply.userId.size() <= 200 &&
        reply.userName is string &&
        reply.userName.size() <= 200 &&
        (
          reply.get('userAvatar', null) == null ||
          (
            reply.get('userAvatar', '') is string &&
            reply.get('userAvatar', '').size() <= 2000
          )
        ) &&
        reply.content is string &&
        reply.content.size() > 0 &&
        reply.content.size() <= 2000 &&
        reply.timestamp is timestamp &&
        reply.supervisorAtAuthorTime is bool;
    }

    function isValidAnnotationData(data) {
      return data.keys().hasAll([
          'screenplayId', 'projectId', 'userId', 'userName', 'userAvatar',
          'annotation', 'timestamp', 'pageNumber', 'position', 'replies',
          'resolved', 'supervisorAtAuthorTime', 'priority'
        ]) &&
        data.keys().hasOnly([
          'screenplayId', 'projectId', 'userId', 'userName', 'userAvatar',
          'annotation', 'timestamp', 'pageNumber', 'position', 'selection',
          'replies', 'resolved', 'supervisorAtAuthorTime', 'mentionedUserIds',
          'priority'
        ]) &&
        isValidScreenplayElementAnchor(data) &&
        hasValidMentionRecipients(data) &&
        data.annotation is string &&
        data.annotation.size() > 0 &&
        data.annotation.size() <= 5000 &&
        data.replies is list &&
        data.replies.size() == 0 &&
        data.priority in ['low', 'medium', 'high', 'critical'];
    }

    function isValidTagData(data) {
      return data.keys().hasAll([
          'screenplayId', 'projectId', 'userId', 'userName', 'userAvatar',
          'tagType', 'content', 'timestamp', 'pageNumber', 'position', 'color',
          'resolved', 'supervisorAtAuthorTime'
        ]) &&
        data.keys().hasOnly([
          'screenplayId', 'projectId', 'userId', 'userName', 'userAvatar',
          'tagType', 'content', 'timestamp', 'pageNumber', 'position', 'selection',
          'color', 'resolved', 'supervisorAtAuthorTime', 'mentionedUserIds'
        ]) &&
        isValidScreenplayElementAnchor(data) &&
        hasValidMentionRecipients(data) &&
        data.tagType in [
          'cast_member', 'background_actors', 'stunts', 'vehicles', 'props',
          'camera', 'special_effects', 'vfx', 'mechanical_effects', 'wardrobe',
          'makeup_hair', 'animals', 'animal_wrangler', 'music', 'sound',
          'art_department', 'set_dressing', 'greenery', 'special_equipment',
          'security', 'additional_labor', 'miscellaneous', 'other', 'notes',
          'comments', 'set', 'sequence', 'script_day', 'unit', 'location',
          'character', 'character_arc', 'character_development',
          'location_detail', 'costume', 'makeup', 'scene', 'scene_transition',
          'scene_beat', 'lighting', 'plot_point', 'subplot', 'theme', 'budget',
          'schedule', 'logistics', 'note', 'revision', 'research'
        ] &&
        data.content is string &&
        data.content.size() > 0 &&
        data.content.size() <= 2000 &&
        data.color is string &&
        data.color.size() > 0 &&
        data.color.size() <= 32;
    }

    function canModerateAnnotationData(data) {
      return canAccessScreenplay(data.screenplayId) &&
        (
          data.userId == request.auth.uid ||
          (
            data.get('supervisorAtAuthorTime', false) == true &&
            isScreenplaySupervisor(data.screenplayId, request.auth.uid)
          ) ||
          (
            data.get('supervisorAtAuthorTime', false) != true &&
            (
              isScreenplayManager(data.screenplayId, request.auth.uid) ||
              isScreenplaySupervisor(data.screenplayId, request.auth.uid)
            )
          )
        );
    }

    function isValidSceneMetadata(data) {
      return data.sceneNumber is string &&
        data.sceneNumber.size() <= 20 &&
        data.intExt in ['', 'INT', 'EXT', 'INT/EXT'] &&
        data.location is string &&
        data.location.size() <= 200 &&
        data.timeOfDay is string &&
        data.timeOfDay.size() <= 80 &&
        data.synopsis is string &&
        data.synopsis.size() <= 2000 &&
        data.note is string &&
        data.note.size() <= 500 &&
        data.get('scriptDay', '') is string &&
        data.get('scriptDay', '').size() <= 40 &&
        data.get('unit', '') is string &&
        data.get('unit', '').size() <= 40 &&
        data.get('sequence', '') is string &&
        data.get('sequence', '').size() <= 80 &&
        data.get('estimatedTime', '') is string &&
        data.get('estimatedTime', '').size() <= 40 &&
        data.get('sceneNumberAuto', false) is bool;
    }

    function isValidFountainSceneFields(data) {
      return data.get('sourceType', 'pdf') in ['pdf', 'fountain'] &&
        data.get('sourceStatus', 'active') in ['active', 'orphaned'] &&
        data.get('sourceLineIndex', 0) is number &&
        data.get('sourceLineIndex', 0) >= 0 &&
        data.get('sourceOrdinal', 0) is number &&
        data.get('sourceOrdinal', 0) >= 0 &&
        data.get('sourceHeading', '') is string &&
        data.get('sourceHeading', '').size() <= 500 &&
        data.get('estimatedPageEighths', 1) is number &&
        data.get('estimatedPageEighths', 1) >= 1 &&
        data.get('estimatedPageEighths', 1) <= 800;
    }

    function canResolveAnnotationData(data) {
      return canModerateAnnotationData(data) ||
        (
          canAccessScreenplay(data.screenplayId) &&
          data.get('supervisorAtAuthorTime', false) == true &&
          isScreenplayManager(data.screenplayId, request.auth.uid)
        );
    }

    function isAnnotationReplyUpdate(newData, oldData) {
      return canAccessScreenplay(oldData.screenplayId) &&
        newData.diff(oldData).affectedKeys().hasOnly(['replies']) &&
        oldData.get('replies', []) is list &&
        newData.replies is list &&
        newData.replies.size() == oldData.get('replies', []).size() + 1 &&
        newData.replies.size() <= 100 &&
        newData.replies.hasAll(oldData.get('replies', [])) &&
        isValidAnnotationReply(newData.replies[newData.replies.size() - 1]) &&
        newData.replies[newData.replies.size() - 1].userId == request.auth.uid;
    }

    function isAnnotationResolveUpdate(newData, oldData) {
      return canResolveAnnotationData(oldData) &&
        newData.diff(oldData).affectedKeys().hasOnly(['resolved']) &&
        newData.resolved is bool;
    }

    // SECURITY: teacher privilege is granted ONLY via the Admin SDK writing a
    // teacherRoles/{uid} doc (scripts/grant-teacher-role.cjs). The previous check
    // read crewProfiles.isTeacher / profileType, which are USER-WRITABLE profile
    // fields — any student could set them on their own profile and self-elect as
    // workspace supervisor (grading CSV access, teacher-styled notes). Those
    // crewProfiles fields are now cosmetic/display-only; never gate privileges
    // on them again.
    function isVerifiedTeacher(uid) {
      return exists(/databases/$(database)/documents/teacherRoles/$(uid));
    }

    function isSelfSupervisorToggle(workspaceData, requestData, uid) {
      return signedIn() &&
        workspaceData.memberIds is list &&
        workspaceData.memberIds.hasAny([uid]) &&
        workspaceData.ownerId != uid &&
        isVerifiedTeacher(uid) &&
        requestData.diff(workspaceData).affectedKeys().hasOnly(['selfElectedSupervisors', 'updatedAt']) &&
        requestData.selfElectedSupervisors is list &&
        (
          // Adding self: new = old + [uid]
          (
            requestData.selfElectedSupervisors.hasAll(workspaceData.get('selfElectedSupervisors', [])) &&
            requestData.selfElectedSupervisors.hasAny([uid]) &&
            !workspaceData.get('selfElectedSupervisors', []).hasAny([uid]) &&
            requestData.selfElectedSupervisors.size() == workspaceData.get('selfElectedSupervisors', []).size() + 1
          ) ||
          // Removing self: new = old - [uid]
          (
            workspaceData.get('selfElectedSupervisors', []).hasAll(requestData.selfElectedSupervisors) &&
            !requestData.selfElectedSupervisors.hasAny([uid]) &&
            workspaceData.get('selfElectedSupervisors', []).hasAny([uid]) &&
            requestData.selfElectedSupervisors.size() == workspaceData.get('selfElectedSupervisors', []).size() - 1
          )
        );
    }

    // Teacher role grants - the privilege source of truth for isVerifiedTeacher().
    // Existence of teacherRoles/{uid} == admin-verified teacher. Writable ONLY via
    // the Admin SDK (scripts/grant-teacher-role.cjs); clients may read their own
    // doc so the UI can show/hide teacher actions.
    match /teacherRoles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // User collections - users can only access their own collections
    match /UserCollections/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users collection - allow reading for messaging compatibility
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Notifications subcollection: only the user can read/write
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if false;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Published profiles are public. Signed-in users retain direct reads for
    // messaging, classroom, application, and collaboration identity lookups.
    // New accounts default to unpublished in the client and must explicitly opt in.
    match /crewProfiles/{profileId} {
      allow read: if signedIn() || resource.data.isPublished == true;
      allow create: if signedIn() &&
        profileId == request.auth.uid &&
        (
          !request.resource.data.keys().hasAny(['uid']) ||
          request.resource.data.uid == request.auth.uid
        );
      allow update: if signedIn() &&
        profileId == request.auth.uid &&
        (
          !request.resource.data.keys().hasAny(['uid']) ||
          request.resource.data.uid == request.auth.uid
        ) &&
        (
          !resource.data.keys().hasAny(['uid']) ||
          request.resource.data.uid == resource.data.uid
        );
      allow delete: if signedIn() && profileId == request.auth.uid;

      // Notifications subcollection: only the user can read/write
      match /notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == profileId;
        allow create: if false;
      }
    }

    // Projects - allow public read for homepage stats, authenticated users can read/write all
    match /projects/{projectId} {
      allow read: if true; // Allow public read for homepage statistics
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Job postings - public read for published/active jobs, authenticated users can write
    match /jobPostings/{jobId} {
      allow read: if request.auth != null || resource.data.status in ['published', 'active'];
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        (resource.data.createdBy == request.auth.uid || resource.data.postedById == request.auth.uid);
    }

    // Blog posts - public read, write restricted to server-side Admin SDK
    match /blogPosts/{postId} {
      allow read: if resource.data.isPublic == true;
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/blogPosts/$(postId)).data.isPublic == true &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.userDisplayName is string &&
          request.resource.data.userDisplayName.size() > 0 &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 1000;
        allow update: if request.auth != null &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt']) &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 1000;
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }

    function isApplicant(application) {
      // Check if application exists before accessing its data
      return application != null && (
        // For new documents, check the request data
        (!application.exists && request.resource.data.applicantId == request.auth.uid) ||
        // For existing documents, check the document data
        (application.exists && application.data.applicantId != null && 
         application.data.applicantId == request.auth.uid)
      );
    }

    function isJobPoster(application) {
      // Check if application exists before accessing its data
      return application != null && (
        // For new documents, check the request data
        (!application.exists && 
         request.resource.data.jobId != null &&
         get(/databases/$(database)/documents/jobPostings/$(request.resource.data.jobId)).data.postedById == request.auth.uid) ||
        // For existing documents, check the document data
        (application.exists && 
         application.data.jobId != null &&
         get(/databases/$(database)/documents/jobPostings/$(application.data.jobId)).data.postedById == request.auth.uid)
      );
    }
    
    function canAccessApplicationId(applicationId) {
      return signedIn() &&
        applicationId is string &&
        exists(/databases/$(database)/documents/jobApplications/$(applicationId)) &&
        (
          isApplicant(get(/databases/$(database)/documents/jobApplications/$(applicationId))) ||
          isJobPoster(get(/databases/$(database)/documents/jobApplications/$(applicationId)))
        );
    }

    match /jobApplications/{applicationId} {
      allow read: if request.auth != null && (isApplicant(resource) || isJobPoster(resource));
      allow create: if request.auth != null && request.resource.data.applicantId == request.auth.uid;
      allow update: if request.auth != null && (
        // Applicant can update their own application
        (isApplicant(resource) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'lastUpdated'])) ||
        // Job poster can update status and notes
        (isJobPoster(resource) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'lastUpdated', 'reviewedAt']))
      );
      allow delete: if request.auth != null && isApplicant(resource);

      // Messaging subcollection: allow both applicant and job poster to read/write
      match /messages/{messageId} {
        // Allow list if user is either the applicant or job poster
        // This is needed for the initial query and real-time updates
        allow list: if request.auth != null && (
          // Check if user is the applicant
          (get(/databases/$(database)/documents/jobApplications/$(applicationId)).data.applicantId == request.auth.uid) ||
          // Or if user is the job poster
          (get(/databases/$(database)/documents/jobPostings/$(get(/databases/$(database)/documents/jobApplications/$(applicationId)).data.jobId)).data.postedById == request.auth.uid)
        );
          
        // Allow get if user is either the sender or has access to the application
        allow get: if request.auth != null && (
          // User is the message sender
          resource.data.senderId == request.auth.uid ||
          // Or user is the applicant
          get(/databases/$(database)/documents/jobApplications/$(applicationId)).data.applicantId == request.auth.uid ||
          // Or user is the job poster
          get(/databases/$(database)/documents/jobPostings/$(get(/databases/$(database)/documents/jobApplications/$(applicationId)).data.jobId)).data.postedById == request.auth.uid
        );
        
        // Allow create if user is the sender and the message is for this application
        allow create: if request.auth != null && 
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.applicationId == applicationId;
          
        // Allow update only for read receipts and reactions
        allow update: if request.auth != null && (
          // User is the message sender
          resource.data.senderId == request.auth.uid ||
          // Or user is the applicant
          get(/databases/$(database)/documents/jobApplications/$(applicationId)).data.applicantId == request.auth.uid ||
          // Or user is the job poster
          get(/databases/$(database)/documents/jobPostings/$(get(/databases/$(database)/documents/jobApplications/$(applicationId)).data.jobId)).data.postedById == request.auth.uid
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'reactions']);
      }
    }

    // Project-scoped tasks. The caller must have access to the owning project.
    match /tasks/{taskId} {
      allow read, update, delete: if canAccessProjectScopedData(resource.data);
      allow create: if canAccessProjectScopedData(request.resource.data);
    }

    // Public reference data. Client writes are intentionally blocked.
    match /countries/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /cities/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /jobDepartments/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /jobTitles/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /savedJobs/{savedJobId} {
      allow read, update, delete: if ownsUserId(resource.data);
      allow create: if ownsUserId(request.resource.data);
    }

    match /savedSearches/{savedSearchId} {
      allow read, update, delete: if ownsUserId(resource.data);
      allow create: if ownsUserId(request.resource.data);
    }

    match /jobViewHistory/{viewId} {
      allow read, update, delete: if ownsUserId(resource.data);
      allow create: if ownsUserId(request.resource.data);
    }

    match /userPreferences/{userId} {
      allow read, write: if signedIn() && userId == request.auth.uid;
    }

    match /emailTracking/{trackingId} {
      allow read, write: if signedIn() &&
        (trackingId == request.auth.uid || trackingId == request.auth.token.email);
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if ownsUserId(resource.data);
      allow create: if false;
    }

    match /workspaceInvitations/{invitationId} {
      allow read: if signedIn() && (
        resource.data.inviteeId == request.auth.uid ||
        resource.data.inviterId == request.auth.uid ||
        isWorkspaceOwner(resource.data.workspaceId, request.auth.uid)
      );
      allow create: if signedIn() &&
        request.resource.data.inviterId == request.auth.uid &&
        request.resource.data.workspaceId is string &&
        isWorkspaceOwner(request.resource.data.workspaceId, request.auth.uid) &&
        request.resource.data.inviteeId is string &&
        request.resource.data.role in ['member', 'supervisor', 'viewer'] &&
        request.resource.data.status == 'pending';
      // Invitation acceptance/decline changes membership and screenplay access, so it must
      // go through the Admin SDK callable `respondToWorkspaceInvitation`.
      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.inviterId == request.auth.uid ||
        isWorkspaceOwner(resource.data.workspaceId, request.auth.uid)
      );
    }

    match /followRequests/{requestId} {
      allow read, delete: if signedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if signedIn() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if signedIn() &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.fromUserId == resource.data.fromUserId &&
        request.resource.data.toUserId == resource.data.toUserId &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.followerId is string &&
        request.resource.data.followingId is string &&
        request.resource.data.followerId != request.resource.data.followingId &&
        (
          (
            request.resource.data.status == 'pending' &&
            request.resource.data.followerId == request.auth.uid
          ) ||
          (
            request.resource.data.status == 'active' &&
            (
              request.resource.data.followingId == request.auth.uid ||
              (
                request.resource.data.get('isAutoFollow', false) == true &&
                request.resource.data.followerId == request.auth.uid
              )
            )
          )
        );
      allow update: if signedIn() &&
        resource.data.followingId == request.auth.uid &&
        request.resource.data.followerId == resource.data.followerId &&
        request.resource.data.followingId == resource.data.followingId &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if signedIn() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followingId == request.auth.uid
      );
    }

    match /activityFeed/{activityId} {
      allow read: if signedIn() || resource.data.isPublic == true;
      allow create: if ownsUserId(request.resource.data);
      allow update: if ownsUserId(resource.data) ||
        (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments']));
      allow delete: if ownsUserId(resource.data);
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow create: if ownsUserId(request.resource.data);
      allow delete: if ownsUserId(resource.data);
      allow update: if false;
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if ownsUserId(request.resource.data);
      allow update, delete: if ownsUserId(resource.data);
    }

    match /connections/{connectionId} {
      allow read: if isConnectionParticipant(resource.data);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isConnectionParticipant(resource.data);
    }

    match /collaborations/{collaborationId} {
      allow read, update, delete: if ownsUserId(resource.data);
      allow create: if signedIn() && request.resource.data.userId is string;
    }

    // Project-management collections are scoped to the owning project.
    match /projectCrew/{docId} {
      allow read, update, delete: if canAccessProjectScopedData(resource.data);
      allow create: if canAccessProjectScopedData(request.resource.data);
    }

    match /projectBudgets/{docId} {
      allow read, update, delete: if canAccessProjectScopedData(resource.data);
      allow create: if canAccessProjectScopedData(request.resource.data);
    }

    match /projectTimelines/{docId} {
      allow read, update, delete: if canAccessProjectScopedData(resource.data);
      allow create: if canAccessProjectScopedData(request.resource.data);
    }

    match /projectDocuments/{docId} {
      allow read, update, delete: if canAccessProjectScopedData(resource.data);
      allow create: if canAccessProjectScopedData(request.resource.data);
    }

    match /projectMilestones/{docId} {
      allow read, update, delete: if canAccessProjectScopedData(resource.data);
      allow create: if canAccessProjectScopedData(request.resource.data);
    }

    match /projectBudget/{docId} {
      allow read, update, delete: if canAccessProjectScopedData(resource.data);
      allow create: if canAccessProjectScopedData(request.resource.data);
    }

    match /crewAvailability/{docId} {
      allow read: if signedIn();
      allow create: if ownsUserId(request.resource.data);
      allow update, delete: if ownsUserId(resource.data);
    }

    match /collaborativeTasks/{taskId} {
      allow read, update, delete: if canAccessProjectScopedData(resource.data);
      allow create: if canAccessProjectScopedData(request.resource.data);
    }

    match /breakdownElements/{elementId} {
      allow read, update, delete: if canAccessProjectScopedData(resource.data);
      allow create: if canAccessProjectScopedData(request.resource.data);
    }

    match /applicationMessages/{messageId} {
      allow read: if canAccessApplicationId(resource.data.applicationId);
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        canAccessApplicationId(request.resource.data.applicationId);
      allow update: if signedIn() &&
        request.resource.data.senderId == resource.data.senderId &&
        canAccessApplicationId(resource.data.applicationId);
      allow delete: if canAccessApplicationId(resource.data.applicationId);
    }

    match /interviews/{interviewId} {
      allow read, update, delete: if canAccessApplicationId(resource.data.applicationId);
      allow create: if canAccessApplicationId(request.resource.data.applicationId);
    }

    match /screenplays/{screenplayId} {
      allow get: if isScreenplayMemberData(resource.data);
      allow list: if isScreenplayOwnerData(resource.data);
      allow list: if isScreenplayTeamMemberData(resource.data);
      allow list: if canAccessWorkspace(resource.data.workspaceId);
      allow create: if request.resource.data.uploadedBy == request.auth.uid &&
        canEditScreenplayData(request.resource.data);
      allow update: if keepsScreenplayOwnership(request.resource.data, resource.data) &&
        (
          isScreenplayContentUpdate(request.resource.data, resource.data) ||
          isScreenplayAccessUpdate(request.resource.data, resource.data) ||
          isScreenplayReviewStatusUpdate(request.resource.data, resource.data, screenplayId)
        );
      allow delete: if canDeleteScreenplayData(resource.data);
    }

    match /screenplayAnnotations/{annotationId} {
      allow read: if canAccessScreenplay(resource.data.screenplayId);
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isValidAnnotationData(request.resource.data) &&
        request.resource.data.supervisorAtAuthorTime ==
          isScreenplaySupervisor(request.resource.data.screenplayId, request.auth.uid) &&
        canAccessScreenplay(request.resource.data.screenplayId);
      allow update: if keepsAnnotationIdentity(request.resource.data, resource.data) &&
        (
          isAnnotationReplyUpdate(request.resource.data, resource.data) ||
          isAnnotationResolveUpdate(request.resource.data, resource.data)
        );
      allow delete: if canModerateAnnotationData(resource.data);
    }

    match /screenplayTags/{tagId} {
      allow read: if canAccessScreenplay(resource.data.screenplayId);
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isValidTagData(request.resource.data) &&
        request.resource.data.supervisorAtAuthorTime ==
          isScreenplaySupervisor(request.resource.data.screenplayId, request.auth.uid) &&
        canAccessScreenplay(request.resource.data.screenplayId);
      allow update: if keepsAnnotationIdentity(request.resource.data, resource.data) &&
        isAnnotationResolveUpdate(request.resource.data, resource.data);
      allow delete: if canModerateAnnotationData(resource.data);
    }

    // Scene records back both PDF marks and Fountain-derived headings. Any current
    // screenplay participant may edit production metadata. Source anchor movement is
    // reserved for users who may edit the screenplay itself.
    match /screenplayScenes/{sceneId} {
      allow read: if canAccessScreenplay(resource.data.screenplayId);
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.screenplayId is string &&
        request.resource.data.pageNumber is number &&
        request.resource.data.position is map &&
        isValidSceneMetadata(request.resource.data) &&
        isValidFountainSceneFields(request.resource.data) &&
        request.resource.data.selection is string &&
        request.resource.data.selection.size() <= 500 &&
        canAccessScreenplay(request.resource.data.screenplayId);
      allow update: if signedIn() &&
        canAccessScreenplay(resource.data.screenplayId) &&
        keepsAnnotationIdentity(request.resource.data, resource.data) &&
        isValidSceneMetadata(request.resource.data) &&
        isValidFountainSceneFields(request.resource.data) &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sceneNumber',
            'sceneNumberAuto',
            'intExt',
            'location',
            'timeOfDay',
            'synopsis',
            'note',
            'scriptDay',
            'unit',
            'sequence',
            'estimatedTime'
          ]) ||
          (
            resource.data.get('sourceType', 'pdf') == 'fountain' &&
            request.resource.data.get('sourceType', 'pdf') == 'fountain' &&
            canEditScreenplay(resource.data.screenplayId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'sceneNumber',
              'intExt',
              'location',
              'timeOfDay',
              'pageNumber',
              'position',
              'selection',
              'sourceType',
              'sourceLineIndex',
              'sourceHeading',
              'sourceOrdinal',
              'sourceStatus',
              'estimatedPageEighths',
              'lastSyncedAt'
            ])
          )
        );
      allow delete: if canModerateAnnotationData(resource.data);
    }

    match /screenplaySessions/{sessionId} {
      allow read, update, delete: if canAccessScreenplay(resource.data.screenplayId);
      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.hasAny([request.auth.uid]) &&
        canAccessScreenplay(request.resource.data.screenplayId);
    }

    match /workspaceMemberships/{membershipId} {
      allow get, list: if signedIn() &&
        resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() &&
        request.resource.data.workspaceId is string &&
        request.resource.data.userId is string &&
        isWorkspaceOwner(request.resource.data.workspaceId, request.auth.uid);
      allow delete: if signedIn() &&
        isWorkspaceOwner(resource.data.workspaceId, request.auth.uid);
    }

    // Append-only activity log per workspace. Readable by workspace members; each event is
    // self-authored (actorUid == caller) by a member. Immutable (no update); owner may prune.
    match /workspaceActivity/{activityId} {
      allow read: if canAccessWorkspace(resource.data.workspaceId);
      allow create: if signedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.workspaceId is string &&
        canAccessWorkspace(request.resource.data.workspaceId);
      allow update: if false;
      allow delete: if signedIn() &&
        isWorkspaceOwner(resource.data.workspaceId, request.auth.uid);
    }

    // A teacher's PRIVATE organizer: classes that group their workspaces, with a
    // student roster, per-student ticks, and a to-do checklist. Owner-only in every
    // mode; creation additionally requires an admin-granted teacherRoles doc so
    // students cannot create classes. Students never read these docs.
    match /teacherClasses/{classId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        exists(/databases/$(database)/documents/teacherRoles/$(request.auth.uid)) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120;
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Assignments posted to a group (class work, no due dates in v1). Readable by group
    // members. Only the group owner or an effective supervisor (the teacher) may create,
    // and each doc is self-authored. The creator may edit the text fields while they
    // still belong to the group; the creator or the group owner may delete. Screenplays
    // reference these via an optional assignmentId set at creation.
    match /workspaceAssignments/{assignmentId} {
      allow read: if canAccessWorkspace(resource.data.workspaceId);
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.workspaceId is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 5000 &&
        canAccessWorkspace(request.resource.data.workspaceId) &&
        (
          isWorkspaceOwner(request.resource.data.workspaceId, request.auth.uid) ||
          isEffectiveWorkspaceSupervisor(request.resource.data.workspaceId, request.auth.uid)
        );
      // Only the creator may edit, only the text fields — workspaceId and createdBy
      // stay immutable so an assignment can never be moved or reowned — and only
      // while they still have access to the group.
      allow update: if signedIn() &&
        resource.data.createdBy == request.auth.uid &&
        canAccessWorkspace(resource.data.workspaceId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'updatedAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 5000;
      allow delete: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        isWorkspaceOwner(resource.data.workspaceId, request.auth.uid)
      );
    }

    match /workspaces/{workspaceId} {
      allow get: if signedIn() &&
        isWorkspaceMemberData(resource.data, request.auth.uid);
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds is list &&
        request.resource.data.memberIds.hasAny([request.auth.uid]);
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isSelfSupervisorToggle(resource.data, request.resource.data, request.auth.uid)
      );
      // The owner may permanently delete a soft-deleted workspace at any time during the
      // recovery window (the "Delete permanently" action) — the window is a convenience for
      // recovery, not a lock. Must be soft-deleted first (status == 'deleted').
      allow delete: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        resource.data.status == 'deleted';
    }

    match /collaborationSessions/{sessionId} {
      allow read, update, delete: if signedIn() &&
        resource.data.participants is list &&
        resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if signedIn() &&
          isConversationParticipant(get(/databases/$(database)/documents/collaborationSessions/$(sessionId)).data);
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          isConversationParticipant(get(/databases/$(database)/documents/collaborationSessions/$(sessionId)).data);
      }

      match /typing/{userId} {
        allow read: if signedIn() &&
          isConversationParticipant(get(/databases/$(database)/documents/collaborationSessions/$(sessionId)).data);
        allow write: if signedIn() &&
          userId == request.auth.uid &&
          isConversationParticipant(get(/databases/$(database)/documents/collaborationSessions/$(sessionId)).data);
      }
    }

    // Public homepage stats (if needed)
    match /Projects/{projectId} {
      allow read: if true; // Allow public reading for homepage statistics
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.owner_uid == request.auth.uid &&
        request.resource.data.owner_uid == resource.data.owner_uid;
      allow delete: if signedIn() && resource.data.owner_uid == request.auth.uid;
    }

    // Direct Messages - users can only access their own conversations
    match /directMessages/{messageId} {
      // Allow read if user is either sender or receiver
      allow read: if ownsSenderOrReceiver(resource.data);
      
      // Allow create if user is the sender
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid;
      
      // Allow update for read receipts and reactions
      allow update: if ownsSenderOrReceiver(resource.data) &&
        // Only allow updating specific fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'reactions', 'status']);
    }
    
    // Favorites - users can only access their own favorites
    match /favorites/{favoriteId} {
      allow read, update, delete: if ownsUserId(resource.data);
      allow create: if ownsUserId(request.resource.data);
    }

    match /crewFavorites/{favoriteId} {
      allow read, update, delete: if ownsUserId(resource.data);
      allow create: if ownsUserId(request.resource.data);
    }
    
    // Chat conversations - users can only access their own conversations
    match /conversations/{conversationId} {
      // Allow read if user is a participant in the conversation
      allow read: if isConversationParticipant(resource.data);
      
      // Allow create if user is including themselves as a participant
      allow create: if isConversationParticipant(request.resource.data);
      
      // Messages subcollection
      match /messages/{messageId} {
        // Allow read if user is a participant in the parent conversation
        allow read: if isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        
        // Allow create if user is the sender and a participant in the conversation
        allow create: if signedIn() &&
          request.auth.uid == request.resource.data.senderId &&
          isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        
        // Participants may update messages, but content-bearing fields are
        // sender-only. Non-senders are limited to reactions, read receipts,
        // and hiding the message on their side (delete-for-me). Without the
        // split, any participant could rewrite the other person's messages.
        allow update: if isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
          (
            (
              // Sender: edits and delete-for-everyone placeholder rewrites.
              resource.data.get('senderId', '') == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'isRead', 'readAt', 'status', 'content', 'fileUrl', 'messageType', 'deletedAt', 'deletedForReceiver'])
            ) ||
            (
              // Non-sender: receipts, reactions, delete-for-me only.
              resource.data.get('senderId', '') != request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'isRead', 'readAt', 'status', 'deletedAt', 'deletedForReceiver'])
            )
          );
        
        // Allow delete if user is the message sender
        allow delete: if request.auth != null && 
          resource.data.senderId == request.auth.uid;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
