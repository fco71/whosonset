rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /project-images/{allPaths=**} {
      allow read: if true; // Public read for project images
      allow write: if request.auth != null; // Allow uploads for authenticated users
    }
    match /profileImages/{allPaths=**} {
      allow read: if true; // Public read for profile images
      allow write: if request.auth != null; // Allow uploads for authenticated users
    }
    match /screenplays/{allPaths=**} {
      allow read: if request.auth != null; // Authenticated read only — screenplays are confidential
      allow write: if request.auth != null;
    }
    match /chat-uploads/{allPaths=**} {
      allow read: if request.auth != null; // Only authenticated users can read chat files
      allow write: if request.auth != null; // Allow uploads for authenticated users
    }
    match /chat-images/{allPaths=**} {
      allow read: if request.auth != null; // Only authenticated users can read chat images
      allow write: if request.auth != null; // Allow uploads for authenticated users
    }
    match /chat-audio/{allPaths=**} {
      allow read: if request.auth != null; // Only authenticated users can read chat audio
      allow write: if request.auth != null; // Allow uploads for authenticated users
    }
    match /test/{allPaths=**} {
      allow read: if request.auth != null; // Only authenticated users can read test files
      allow write: if request.auth != null; // Allow uploads for authenticated users
    }
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId; // Users can only read their own files
      allow write: if request.auth != null && request.auth.uid == userId; // Users can only write to their own folder
    }
    match /projects/{projectId}/{allPaths=**} {
      allow read: if true; // Public read for project images
      allow write: if request.auth != null; // Allow uploads for authenticated users
    }
    match /project-documents/{projectId}/{allPaths=**} {
      allow read: if request.auth != null; // Authenticated read only — project documents are confidential
      allow write: if request.auth != null;
    }
    // Add more rules as needed for other folders
  }
}
