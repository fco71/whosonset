rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImageUpload() {
      return request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    function isDocumentUpload() {
      return request.resource != null &&
        request.resource.size < 25 * 1024 * 1024;
    }

    match /project-images/{userId}/{allPaths=**} {
      allow read: if true; // Public read for project images
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId);
    }

    match /profileImages/{userId}/{allPaths=**} {
      allow read: if true; // Public read for profile images
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId);
    }

    match /screenplays/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isDocumentUpload();
    }

    match /chat-uploads/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isDocumentUpload();
      allow delete: if isOwner(userId);
    }

    match /voice-messages/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isDocumentUpload();
      allow delete: if isOwner(userId);
    }

    match /chat-images/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId);
    }

    match /chat-audio/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isDocumentUpload();
      allow delete: if isOwner(userId);
    }

    match /test/{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId); // Users can only read their own files
      allow create, update: if isOwner(userId) && isDocumentUpload();
      allow delete: if isOwner(userId);
    }

    match /applications/{applicationId}/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isDocumentUpload();
    }

    match /projects/{projectId}/{userId}/{allPaths=**} {
      allow read: if true; // Public read for project images
      allow create, update: if isOwner(userId) && isImageUpload();
      allow delete: if isOwner(userId);
    }

    match /project-documents/{projectId}/{userId}/{allPaths=**} {
      allow read: if signedIn(); // Authenticated read only; Firestore metadata controls discoverability.
      allow create, update: if isOwner(userId) && isDocumentUpload();
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
