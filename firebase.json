{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": [
    {
      "target": "production",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "@(login|register|verify-email|forgot-password|reset-password|crew|projects|my-students|my-projects|saved-crew|saved-projects|collections|social|chat|collaboration|settings|edit-profile|post-job|applications|debug-jobs|email-test|email-integration-test|password-reset-test)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "@(projects|my-projects|saved-crew|saved-projects|collections|social|chat|collaboration|settings|applications)/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "jobs/@(posted|applied|saved|analytics)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "jobs/*/@(apply|applications)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "sitemap-jobs.xml",
          "function": {
            "functionId": "jobsSitemap",
            "region": "us-central1"
          }
        },
        {
          "source": "sitemap-blog.xml",
          "function": {
            "functionId": "blogSitemap",
            "region": "us-central1"
          }
        },
        {
          "source": "jobs/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "blog/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "resume/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "directorio",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "directorio/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "directory",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "directory/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "development",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "@(login|register|verify-email|forgot-password|reset-password|crew|projects|my-students|my-projects|saved-crew|saved-projects|collections|social|chat|collaboration|settings|edit-profile|post-job|applications|debug-jobs|email-test|email-integration-test|password-reset-test)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "@(projects|my-projects|saved-crew|saved-projects|collections|social|chat|collaboration|settings|applications)/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "jobs/@(posted|applied|saved|analytics)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "jobs/*/@(apply|applications)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "sitemap-jobs.xml",
          "function": {
            "functionId": "jobsSitemap",
            "region": "us-central1"
          }
        },
        {
          "source": "sitemap-blog.xml",
          "function": {
            "functionId": "blogSitemap",
            "region": "us-central1"
          }
        },
        {
          "source": "jobs/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "blog/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "resume/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "directorio",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "directorio/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "directory",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "directory/**",
          "function": {
            "functionId": "prerender",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true
  }
}
